---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
import { Icon } from "astro-icon/components";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Research & Expertise | ${SITE_TITLE}`}
      description="Versatile bioinformatics expertise for complex genomic challenges. I apply computational methods across diverse domains to uncover impactful insights to support translational discovery."
    />
    <style>
      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem;
      }

      .research-header {
        text-align: center;
        margin-bottom: 4rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
      }

      .research-header h1 {
        font-family: var(--font-heading);
        font-size: var(--text-5xl);
        color: var(--accent);
        margin-bottom: 1rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .research-header .intro {
        font-family: var(--font-body);
        font-size: var(--text-xl);
        color: var(--accent-secondary);
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      .research-header p {
        font-family: var(--font-body);
        font-size: var(--text-lg);
        color: rgb(var(--gray));
        line-height: 1.6;
      }

      /* Philosophy Section */
      .philosophy-section {
        background: var(--background-cream);
        border-radius: 12px;
        padding: 3rem;
        margin-bottom: 4rem;
        border-left: 6px solid var(--accent);
      }

      .philosophy-section h2 {
        font-size: var(--text-3xl);
        color: var(--accent-secondary);
        margin-bottom: 1.5rem;
      }

      .philosophy-section p {
        font-size: var(--text-lg);
        color: rgb(var(--gray));
        line-height: 1.7;
        margin-bottom: 1.5rem;
      }

      .philosophy-section p:last-child {
        margin-bottom: 0;
      }

      /* Expertise Areas */
      .expertise-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-bottom: 4rem;
      }

      .expertise-card {
        background: var(--background);
        border-radius: 12px;
        padding: 2rem;
        border: 3px solid var(--accent-secondary);
        transition: all 0.3s ease;
      }

      .expertise-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--box-shadow);
        border-color: var(--accent);
      }

      .expertise-card .icon-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .expertise-card .icon {
        color: var(--accent);
      }

      .expertise-card h3 {
        font-size: var(--text-2xl);
        color: var(--accent-secondary);
        margin: 0;
      }

      .expertise-card p {
        color: rgb(var(--gray));
        line-height: 1.6;
        margin-bottom: 1rem;
      }

      .expertise-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .expertise-card li {
        color: rgb(var(--gray));
        padding: 0.5rem 0;
        padding-left: 1.5rem;
        position: relative;
      }

      .expertise-card li::before {
        content: "→";
        position: absolute;
        left: 0;
        color: var(--accent);
        font-weight: bold;
      }

      /* Research Journey Section */
      .journey-section {
        margin-bottom: 4rem;
      }

      .journey-section h2 {
        font-size: var(--text-4xl);
        color: var(--accent);
        text-align: center;
        margin-bottom: 3rem;
      }

      .journey-timeline {
        position: relative;
        padding-left: 2rem;
      }

      .journey-timeline::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(
          to bottom,
          var(--accent) 0%,
          var(--accent-secondary) 50%,
          var(--accent-tertiary) 100%
        );
      }

      .journey-item {
        position: relative;
        margin-bottom: 3rem;
        padding-left: 2rem;
      }

      .journey-item::before {
        content: "";
        position: absolute;
        left: -2rem;
        top: 0.5rem;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--accent);
        border: 3px solid var(--background);
        box-shadow: 0 0 0 3px var(--accent);
      }

      .journey-item h3 {
        font-size: var(--text-2xl);
        color: var(--accent-secondary);
        margin-bottom: 0.5rem;
      }

      .journey-item .meta {
        font-size: var(--text-base);
        color: rgb(var(--gray-light));
        margin-bottom: 1rem;
        font-style: italic;
      }

      .journey-item p {
        color: rgb(var(--gray));
        line-height: 1.7;
        margin-bottom: 1rem;
      }

      .journey-item .highlight {
        background: var(--background-cream);
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid var(--accent-tertiary);
        margin-top: 1rem;
      }

      .journey-item .highlight strong {
        color: var(--accent);
      }

      /* Publications Section */
      .publications-section {
        background: var(--background-cream);
        padding: 3rem;
        border-radius: 12px;
        margin-bottom: 4rem;
      }

      .publications-section h2 {
        font-size: var(--text-3xl);
        color: var(--accent);
        text-align: center;
        margin-bottom: 2rem;
      }

      .publications-section p {
        text-align: center;
        font-size: var(--text-lg);
        color: rgb(var(--gray));
        margin-bottom: 2rem;
      }

      .scholar-link {
        text-align: center;
      }

      .scholar-link a {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: var(--accent);
        color: white;
        padding: 1rem 2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: var(--text-lg);
        transition: all 0.3s ease;
      }

      .scholar-link a:hover {
        background: var(--accent-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(6, 95, 70, 0.3);
      }

      /* CTA Section */
      .cta-section {
        text-align: center;
        padding: 3rem 2rem;
        background: var(--background);
        border-radius: 12px;
        border: 3px solid var(--accent-secondary);
      }

      .cta-section h2 {
        font-size: var(--text-3xl);
        color: var(--accent-secondary);
        margin-bottom: 1rem;
      }

      .cta-section p {
        font-size: var(--text-lg);
        color: rgb(var(--gray));
        margin-bottom: 2rem;
      }

      .cta-section a {
        display: inline-block;
        background: var(--accent);
        color: white;
        padding: 1rem 2.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: var(--text-lg);
        transition: all 0.3s ease;
      }

      .cta-section a:hover {
        background: var(--accent-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(6, 95, 70, 0.3);
      }

      @media (max-width: 768px) {
        main {
          padding: 2rem 1rem;
        }

        .research-header h1 {
          font-size: var(--text-4xl);
        }

        .philosophy-section {
          padding: 2rem;
        }

        .expertise-grid {
          grid-template-columns: 1fr;
        }

        .journey-timeline {
          padding-left: 1.5rem;
        }

        .journey-item {
          padding-left: 1.5rem;
        }

        .publications-section {
          padding: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="research-header">
        <h1>Research & Expertise</h1>
        <p class="intro">Transforming genomic data into insights that improve patient outcomes</p>
        <p>
          My work focuses on human genomics in the pharmaceutical sector—applying computational
          methods to rare disease research, internal medicine, and drug discovery. Strong
          computational foundations allow me to tackle complex challenges across the translational
          research pipeline.
        </p>
      </div>

      <!-- Philosophy Section -->
      <section class="philosophy-section">
        <h2>Impact-Driven Genomics</h2>
        <p>
          In the pharmaceutical sector, genomic analysis isn't academic—it's about finding answers
          that can transform patients' lives. Whether identifying rare disease variants,
          understanding drug response mechanisms, or validating therapeutic targets, the stakes are
          real and the challenges are complex.
        </p>
        <p>
          My approach combines rigorous computational methods with a focus on biological relevance.
          I've learned that the most powerful analyses aren't always the most sophisticated—they're
          the ones that answer the right questions with reliable data. That starts with knowing how
          to separate true biological signal from technical artifacts.
        </p>
      </section>

      <!-- Expertise Areas -->
      <section class="expertise-grid">
        <div class="expertise-card">
          <div class="icon-header">
            <Icon name="mdi:hospital-box" width={32} height={32} class="icon" />
            <h3>Rare Disease Genomics</h3>
          </div>
          <p>
            Specialized in analyzing complex genomic data to identify disease-causing variants and
            understand molecular mechanisms in rare disease research.
          </p>
          <ul>
            <li>Rare variant identification & validation</li>
            <li>Multi-omics data integration</li>
            <li>Genetic architecture analysis</li>
            <li>Patient stratification approaches</li>
          </ul>
        </div>

        <div class="expertise-card">
          <div class="icon-header">
            <Icon name="mdi:flask" width={32} height={32} class="icon" />
            <h3>Pharmaceutical R&D</h3>
          </div>
          <p>
            Supporting drug discovery and development through genomic analysis, target validation,
            and biomarker identification.
          </p>
          <ul>
            <li>Target validation & prioritization</li>
            <li>Biomarker discovery</li>
            <li>Pharmacogenomics analysis</li>
            <li>Clinical trial support</li>
          </ul>
        </div>

        <div class="expertise-card">
          <div class="icon-header">
            <Icon name="mdi:chart-line" width={32} height={32} class="icon" />
            <h3>Data Quality & Methods</h3>
          </div>
          <p>
            Expert in ensuring data reliability through rigorous QC, artifact detection, and method
            validation—critical for translational research.
          </p>
          <ul>
            <li>Genomic data quality control</li>
            <li>Signal-noise separation methods</li>
            <li>Pipeline validation & optimization</li>
            <li>Reproducible analysis workflows</li>
          </ul>
        </div>
      </section>

      <!-- Research Journey -->
      <section class="journey-section">
        <h2>Research Journey</h2>
        <div class="journey-timeline">
          <div class="journey-item">
            <h3>Current: independent Contractor</h3>
            <div class="meta">Genscience • Remote</div>
            <p>
              Providing specialized bioinformatics consulting to pharmaceutical and biotech
              companies, with focus on subject-level genetic analyses using large-scale biobank
              resources. Working where computational rigor meets real-world patient impact.
            </p>
            <div class="highlight">
              <strong>Core Value:</strong> Bringing deep expertise in genomic data quality and analysis
              to projects where reliability isn't optional—it's essential for clinical and regulatory
              success.
            </div>
          </div>

          <div class="journey-item">
            <h3>Postdoc: Rare Disease & Internal Medicine</h3>
            <div class="meta">Pfizer Inc. • Cambridge, MA</div>
            <p>
              Worked on genomic analysis for rare disease and internal medicine research programs in
              one of the world's leading pharmaceutical companies. Applied computational expertise
              to complex datasets where insights could directly inform therapeutic development.
            </p>
            <div class="highlight">
              <strong>Key Impact:</strong> Learned to bridge the gap between computational methods and
              pharmaceutical applications—translating technical findings into actionable insights for
              drug discovery teams and understanding what questions matter most for patient outcomes.
            </div>
          </div>

          <div class="journey-item">
            <h3>NHGRI: Human Genome Research</h3>
            <div class="meta">National Human Genome Research Institute, NIH</div>
            <p>
              Contributed to foundational human genomics research at the NIH, working on projects
              advancing our understanding of genome structure, function, and variation across human
              populations.
            </p>
            <div class="highlight">
              <strong>Key Learning:</strong> Developed expertise in large-scale human genomic datasets
              and learned to collaborate across multidisciplinary teams—from clinical researchers to
              computational scientists.
            </div>
          </div>

          <div class="journey-item">
            <h3>PhD: Computational Methods Development</h3>
            <div class="meta">University of Pennsylvania • Genomics & Computational Biology</div>
            <p>
              Built foundational computational expertise through developing novel methods for
              genomic data analysis. Created the Greenscreen approach for systematic artifact
              filtering—learning that reliable insights require knowing what
              <em>not</em> to trust in your data.
            </p>
            <div class="highlight">
              <strong>Core Philosophy:</strong> The best analysis starts with the best data. Developed
              the computational rigor and quality-first mindset that now drives my pharmaceutical work—where
              data reliability directly impacts patient care.
            </div>
          </div>
        </div>
      </section>

      <!-- Publications -->
      <section class="publications-section">
        <h2>Publications & Scholarly Work</h2>
        <p>
          My research has been published in peer-reviewed journals and presented at scientific
          conferences. View my complete publication record and citation metrics.
        </p>
        <div class="scholar-link">
          <a
            href="https://scholar.google.com/citations?user=YOUR_SCHOLAR_ID"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="mdi:school" width={24} height={24} />
            View Google Scholar Profile
          </a>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta-section">
        <h2>Ready to Advance Your Research?</h2>
        <p>
          Whether you're working on rare disease genomics, drug target validation, or clinical
          biomarker discovery, I bring pharmaceutical-focused expertise and a commitment to data
          quality that drives reliable insights.
        </p>
        <a href="/contact">Discuss Your Project</a>
      </section>
    </main>
    <Footer />
  </body>
</html>
