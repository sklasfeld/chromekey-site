---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Message Sent | ${SITE_TITLE}`}
      description="Your message has been successfully sent to Chrome Key Bioinformatics."
    />
    <style>
      main {
        max-width: 800px;
        margin: 0 auto;
        padding: 6rem 2rem;
        text-align: center;
      }

      .success-container {
        background: var(--background-cream);
        border-radius: 12px;
        padding: 3rem 2rem;
        box-shadow: var(--box-shadow);
        border: 3px solid var(--accent);
      }

      .success-icon {
        font-size: 4rem;
        margin-bottom: 1.5rem;
      }

      h1 {
        font-family: var(--font-heading);
        font-size: var(--text-4xl);
        color: var(--accent);
        margin-bottom: 1rem;
        font-weight: 700;
      }

      p {
        font-size: var(--text-lg);
        color: rgb(var(--gray));
        margin-bottom: 1.5rem;
        line-height: 1.6;
      }

      .cta-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
        flex-wrap: wrap;
      }

      .btn {
        padding: 0.875rem 2rem;
        font-size: var(--text-base);
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-block;
      }

      .btn-primary {
        background: var(--accent);
        color: white;
      }

      .btn-primary:hover {
        background: var(--accent-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(6, 95, 70, 0.3);
      }

      .btn-secondary {
        background: transparent;
        color: var(--accent-secondary);
        border: 3px solid var(--accent-secondary);
      }

      .btn-secondary:hover {
        background: var(--accent-secondary);
        color: var(--background);
        transform: translateY(-2px);
      }

      @media (max-width: 768px) {
        main {
          padding: 4rem 1rem;
        }

        .success-container {
          padding: 2rem 1.5rem;
        }

        h1 {
          font-size: var(--text-3xl);
        }

        .cta-buttons {
          flex-direction: column;
          align-items: center;
        }

        .btn {
          width: 100%;
          max-width: 300px;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="success-container">
        <div class="success-icon">✓</div>
        <h1>Message Sent Successfully!</h1>
        <p>
          Thank you for reaching out. I've received your message and will get back to you within 1-2
          business days.
        </p>
        <p>In the meantime, feel free to explore my work or connect with me on LinkedIn.</p>
        <div class="cta-buttons">
          <a href="/" class="btn btn-primary">Return Home</a>
          <a href="/blog" class="btn btn-secondary">Read the Blog</a>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
